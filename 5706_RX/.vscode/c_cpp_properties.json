{
    // AB5726 麦克风固件 IntelliSense 配置。对应 projects/microphone/app.cbp 的 include 目录。
    // compilerPath 指向 RV32-V3 工具链；如安装位置不同，请改为此机 bin\riscv32-elf-gcc.exe 的绝对路径。
    "configurations": [
        {
            "name": "AB5726",
            "includePath": [
                "${workspaceFolder}/projects/microphone",
                "${workspaceFolder}/projects/microphone/display",
                "${workspaceFolder}/projects/microphone/message",
                "${workspaceFolder}/projects/microphone/port",
                "${workspaceFolder}/projects/microphone/plugin",
                "${workspaceFolder}/libs",
                "${workspaceFolder}/include",
                "${workspaceFolder}/3rd-party",
                "${workspaceFolder}/bsp",
                "${workspaceFolder}/system",
                "${workspaceFolder}/modules",
                "${workspaceFolder}/functions",
                "${workspaceFolder}/modules/gui",
                "${workspaceFolder}/modules/gui/ledseg",
                "${workspaceFolder}/modules/gui/lcd",
                "${workspaceFolder}/modules/gui/led",
                "${workspaceFolder}/modules/bluetooth/app/ab_mate",
                "${workspaceFolder}/modules/bluetooth/gfps",
                "${workspaceFolder}/modules/bluetooth/call",
                "${workspaceFolder}/modules/fm",
                "${workspaceFolder}/os",
                "${workspaceFolder}/projects/kbox",
                "${workspaceFolder}/modules/wireless",
                "${workspaceFolder}/modules/wireless/wireless_con_interact"
            ],
            "compilerPath": "D:/software_download/work/rv32-toolchain_v1.5.9/rv32-toolchain_v1.5.9/install/RV32-V3/bin/riscv32-elf-gcc.exe",
            "compilerArgs": [
                "-march=rv32imc_zba_zbb_zbc_zbs_zca_zcb_zcmp_xbs1",
                "-ffunction-sections",
                "-mjump-tables-in-text"
