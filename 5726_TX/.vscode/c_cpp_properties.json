                "${workspaceFolder}/projects/microphone/cpu",
                "${workspaceFolder}/projects/display",
                "${workspaceFolder}/projects/message",
                "${workspaceFolder}/libs/bt8910/liba",
                "${workspaceFolder}/libs/bt8910",
                "${workspaceFolder}/include",
                "${workspaceFolder}/3rd-party",
                "${workspaceFolder}/system",
                "${workspaceFolder}/modules",
                "${workspaceFolder}/functions",
                "${workspaceFolder}/modules/gui",
                "${workspaceFolder}/modules/gui/ledseg",
                "${workspaceFolder}/modules/gui/lcd",
                "${workspaceFolder}/modules/gui/led",
                "${workspaceFolder}/modules/bluetooth",
                "${workspaceFolder}/modules/bluetooth/app/ab_mate",
                "${workspaceFolder}/modules/bluetooth/gfps",
                "${workspaceFolder}/modules/bluetooth/call",
                "${workspaceFolder}/modules/tool",
                "${workspaceFolder}/modules/effect",
                "${workspaceFolder}/projects/microphone/cpu/effect",
                "${workspaceFolder}/os",
                "${workspaceFolder}/modules/wireless"
            ],
            "compilerPath": "D:/software_download/work/rv32-toolchain_v1.5.9/rv32-toolchain_v1.5.9/install/RV32-V3/bin/riscv32-elf-gcc.exe",
            "compilerArgs": [
                "-march=rv32imc_zba_zbb_zbc_zbs_zca_zcb_zcmp_xbs1",
